# Comma-separated list of frontend origins allowed to call this API.
# Add your Vercel URL here once deployed, e.g.:
# ALLOWED_ORIGINS=https://doorstep-trust.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Optional. If unset, the API falls back to a local SQLite file
# (doorstep.db). Set this to a Render Postgres connection string for
# real persistence in production.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
